# =============================================================================
# BioRAG v30.1 — Configuración de Usuario
# =============================================================================
# Copia este archivo a .env.local y descomenta los valores que quieras cambiar.
# Los defaults están en el código — este archivo es SOLO para override.
# Si eliminas este archivo o las variables, el código usa los defaults.
# =============================================================================

# =============================================================================
# 1. BASE DE DATOS
# =============================================================================
# Ruta al archivo .db donde BioRAG guarda toda la memoria.
# Default: ./MemoryBioRAG_Data/memory_biorag.db
# BIORAG_PATH=MemoryBioRAG_Data/memory_biorag.db

# =============================================================================
# 2. LÍMITE DE RESULTADOS (Límite por defecto en búsquedas MCP)
# =============================================================================
# Cuántos resultados retorna cada búsqueda por defecto.
# Default: 10
# BIORAG_LIMITE_MCP=10

# =============================================================================
# 2b. LÍMITE DE ASOCIACIONES PLANAS POR NODO
# =============================================================================
# Cuántos nombres de asociaciones se exponen por nodo en el campo `asociaciones`.
# Default: 12
# BIORAG_MAX_ASOCIACIONES_FLAT=12

# =============================================================================
# 3. CANDIDATOS PARA SIMILITUD CONCEPTUAL
# =============================================================================
# Cuántos nodos candidatos se evalúan para calcular similitud conceptual (Jaccard).
# Default: 100
# BIORAG_CANDIDATOS_SIMILITUD=100

# =============================================================================
# 4. MÁXIMO DE SALTOS EN EVOCACIÓN POR CADENA
# =============================================================================
# Cuántos "hops" de conexión hace el sistema cuando sigue un camino de sinapsis.
# Default: 3
# BIORAG_MAX_SALTOS_CADENA=3

# =============================================================================
# 5. LÍMITE DE RESULTADOS POR CAPA DE BÚSQUEDA
# =============================================================================
# Cuántos resultados máximo saca cada capa del pipeline (FTS5, OR, semántica, etc.)
# Default: 5
# BIORAG_LIMITE_DEFAULT=5

# =============================================================================
# 6. UMBRAL JACCARD PARA SIMILITUD CONCEPTUAL
# =============================================================================
# Score mínimo de Jaccard para considerar que dos nodos son conceptualmente similares.
# Default: 0.15
# BIORAG_UMBRAL_JACCARD=0.15

# =============================================================================
# 7. MOTOR VECTORIAL PPMI + SVD Y RE-RANKING JACCARD
# =============================================================================
# Peso relativo del vectorizador PPMI local (0.0 a 1.0)
# Default: 0.15
# BIORAG_PPMI_WEIGHT=0.15

# Activa el re-ranking Jaccard Fase C
# Default: 1
# BIORAG_RERANKING_JACCARD_ENABLED=1

# =============================================================================
# 8. QCR (QUERY COMPLEXITY ROUTING) GATE
# =============================================================================
# Activa el filtro/gate de complejidad de consulta
# Default: 1
# BIORAG_QCR_ACTIVO=1

# Umbral de escape por score en capa intermedia
# Default: 0.60
# BIORAG_QCR_ESCAPE_CAPA_MIN=0.60

# =============================================================================
# 9. INTEGRIDAD DEL RANKING: ORDEN MONOTÓNICO (v30.1)
# =============================================================================
# Reordena monótonamente los resultados finales por score antes de paginar
# Default: 1
# BIORAG_ORDEN_MONOTONICO=1

# =============================================================================
# 10. RÁFAGA DE REMINISCENCIA (ON/OFF)
# =============================================================================
# Si se activa la ráfaga asociativa durante la búsqueda
# Default: true
# BIORAG_RAFTAGA_ACTIVA=true

# =============================================================================
# 11. RED POR DEFECTO (DMN) / LA HORMIGUITA / GEMINI API KEYS
# =============================================================================
# Claves de API de Gemini separadas por coma para el demonio de reflexión DMN
# GEMINI_API_KEYS=AIzaSy...1,AIzaSy...2

# Logging del demonio Hormiguita (1=activado, 0=desactivado)
# Default: 0
# BIORAG_DAEMON_LOG_ENABLED=0

# =============================================================================
# 12. CADUCIDAD TEMPORAL Y CALIBRACIÓN CONFORME
# =============================================================================
# Días después de los cuales un nodo se marca como 'stale' (obsoleto).
# Default: 90
# BIORAG_STALE_DAYS=90

# Días después de los cuales un nodo se excluye automáticamente (0 = sin cutoff).
# Default: 365
# BIORAG_STALE_HARD_CUTOFF=365

# Activa la abstención por umbral conforme
# Default: 0
# BIORAG_CALIBRACION_ACTIVA=0

# =============================================================================
# 13. EVALUACIÓN QA Y REGRESSION GATE (v30.1)
# =============================================================================
# Falla la suite QA (exit 1) si las métricas caen por debajo del baseline oficial
# Default: 1
# BIORAG_QA_GATE=1

# Mínimo Recall@5 global requerido (%)
# Default: 97.0
# BIORAG_QA_MIN_RECALL5=97.0

# Máximo número de fallos tolerados
# Default: 23
# BIORAG_QA_MAX_FALLOS=23

# Tasa máxima de falsos positivos en negativos (%)
# Default: 0.0
# BIORAG_QA_MAX_FP_RATE=0.0

# Máxima regresión por categoría vs baseline (puntos porcentuales)
# Default: 2.0
# BIORAG_QA_MAX_REGRESION_PP=2.0

# Archivo de baseline oficial para comparación
# Default: qa_metrics_baseline.json
# BIORAG_QA_BASELINE=qa_metrics_baseline.json

# Archivo de métricas machine-readable de salida
# Default: scripts/qa_metrics.json
# BIORAG_QA_METRICS=scripts/qa_metrics.json

# Resolver etiquetas oro obsoletas automáticamente contra la DB evaluada
# Default: 1
# BIORAG_QA_RESOLVER_ETIQUETAS=1
