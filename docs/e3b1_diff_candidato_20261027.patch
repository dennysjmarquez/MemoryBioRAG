+def _sustantivo_valido(termino: str) -> bool:
+    """Valida el formato Unicode sin alterar el término entregado al motor."""
+    s = unicodedata.normalize("NFC", termino)
+    return (
+        2 <= len(s) <= 15
+        and all(unicodedata.category(c)[0] in "LMN" or c == "_" for c in s)
+    )
+
