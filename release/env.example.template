# Optional runtime settings. Never put credentials in a committed file.

# Set to 0 to disable the background Stable update check.
BIORAG_UPDATE_CHECK=1

# The graph-maintenance daemon is opt-in and disabled by default.
BIORAG_DAEMON_ENABLED=0

# Optional token translation can send query tokens to Google Translate.
# Enable only if this external processing is acceptable; deep-translator is not installed by default.
BIORAG_TRADUCCION_ACTIVA=0

# Optional Gemini-backed maintenance can send the selected reflection context to Gemini.
# Add real credentials only to a private, untracked environment file; never commit them.
# GEMINI_API_KEYS=
# GEMINI_API_KEY=
